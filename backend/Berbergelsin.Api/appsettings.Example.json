{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=berbergelsin;Username=berbergelsin;Password=REPLACE_WITH_YOUR_DB_PASSWORD"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_YOUR_STRONG_JWT_SIGNING_KEY",
    "Issuer": "berbergelsin",
    "Audience": "berbergelsin",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "NotificationOutbox": {
    "Enabled": true,
    "PollingIntervalSeconds": 5,
    "BatchSize": 50,
    "LockTimeoutSeconds": 60,
    "MaxAttempts": 8
  },
  "PushNotifications": {
    "Provider": "NoOp",
    "FirebaseProjectId": "REPLACE_PROJECT_ID",
    "CredentialPath": "",
    "Enabled": false
  },
  "SmsSettings": {
    "BaseUrl": "REPLACE_SMS_BASE_URL",
    "AuthHeader": "REPLACE_SMS_AUTH_HEADER",
    "Origin": "REPLACE_SMS_ORIGIN",
    "UseConsoleSender": true
  },
  "Otp": {
    "Pepper": "REPLACE_WITH_YOUR_OTP_PEPPER",
    "ExpiryMinutes": 5,
    "MaxAttempts": 5,
    "MaxSendsPer10Min": 3,
    "ResendSeconds": 60
  },
  "FileStorage": {
    "RootPath": "uploads",
    "MaxSizeBytes": 10485760
  },
  "Seed": {
    "AdminPhone": "",
    "AdminBootstrapPhone": "11111111111"
  }
}
